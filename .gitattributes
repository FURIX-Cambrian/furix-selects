# 换行符按平台规矩来，避免 Windows/macOS 互相改文件
* text=auto eol=lf

*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.command text eol=lf
*.sh      text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.json    text eol=lf

*.jpg     binary
*.jpeg    binary
*.png     binary
*.webp    binary
*.zip     binary